# Copiez ce fichier vers .env.local. Ne versionnez jamais .env.local.

# Connexion PostgreSQL fournie par Neon/Vercel. Utilisez une base de développement séparée.
DATABASE_URL=

# Secret Better Auth d'au moins 32 octets aléatoires. À générer localement, jamais dans le chat.
BETTER_AUTH_SECRET=

# URL canonique locale ; remplacez-la par le domaine HTTPS en production.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application OAuth GitHub. Le secret doit être enregistré dans Vercel et GitHub Environments.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Identifiant numérique immuable du seul compte autorisé (N0thyTVOff).
AUTHORIZED_GITHUB_USER_ID=312060648
