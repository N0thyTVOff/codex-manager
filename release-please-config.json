{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "always-update": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore(main): release ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Fonctionnalités" },
    { "type": "fix", "section": "Corrections" },
    { "type": "perf", "section": "Performances" },
    { "type": "security", "section": "Sécurité" },
    { "type": "docs", "section": "Documentation", "hidden": false },
    { "type": "refactor", "section": "Maintenance", "hidden": false },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Outillage", "hidden": true },
    { "type": "ci", "section": "Intégration continue", "hidden": true },
    { "type": "chore", "section": "Maintenance", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "codex-manager",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
